# {{.BalancerFile}}
# Written by ngc-web (install, configure) and after that by ngc-controller with
# role web, both from /etc/ngc/web.json. Never edit by hand; every write is
# atomic, mode 0644, and Apache is reloaded only after apachectl configtest.
SSLProxyEngine on
SSLProxyVerify require
SSLProxyCACertificateFile {{.TrustFile}}
SSLProxyCheckPeerName on
SSLProxyCheckPeerExpire on
SSLProxyProtocol TLSv1.3
SSLProxyCipherSuite TLSv1.3 TLS_AES_256_GCM_SHA384

<Proxy "balancer://ngc-api">
{{range .APIs}}    BalancerMember "{{.URL}}" retry=5 timeout=65 connectiontimeout=2 keepalive=On upgrade=websocket
{{end}}    ProxySet lbmethod=byrequests failontimeout=On
</Proxy>

# A 503 of the balancer's own carries the same header a busy database gives.
Header always set Retry-After "5" "expr=%{REQUEST_STATUS} == 503"
# A member that cannot be reached belongs in the error log, not only in the
# access log.
LogLevel proxy:info proxy_balancer:info

ProxyPreserveHost Off
ProxyPass        "/api/" "balancer://ngc-api/api/"
ProxyPassReverse "/api/" "balancer://ngc-api/api/"
