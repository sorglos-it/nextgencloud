# The CA of one NGC installation and the certificates of its database nodes.
# ngc-db.sh uses it with openssl; the placeholder @HOST@ becomes the host of
# the node, as a DNS name or, for an IPv4 address, as an IP.
#
# openssl req reads its options from the section -section names, so ca_dn and
# node_dn hold the request options and point at the section with the name.
# Measured with OpenSSL 3.5.7: a section that holds the name alone makes
# "req -section" stop with "No objects specified in config file".
#
# This file has a SECOND copy: ngc-db.sh of the ulh repository carries it as a
# here-document, because ngc-db installs no NGC program files and so has no
# release to read this file from. A change here belongs there as well, and
# apps/cli/tests/ngc-db.test.sh of ulh builds a real CA and a real node
# certificate from that copy.

[ca_dn]
prompt = no
distinguished_name = ca_name

[ca_name]
CN = NGC DB CA

[ca_ext]
basicConstraints = critical,CA:TRUE,pathlen:0
keyUsage = critical,keyCertSign,cRLSign
subjectKeyIdentifier = hash

[node_dn]
prompt = no
distinguished_name = node_name

[node_name]
CN = @HOST@

[node_ext]
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth,clientAuth
# One @ names a section; "@node_alt@" would look for a section called
# "node_alt@" and is not the mark the script replaces.
subjectAltName = @node_alt
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid

[node_alt]
DNS.1 = @HOST@
