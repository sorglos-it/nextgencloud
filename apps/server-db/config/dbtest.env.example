# Zugänge für die Tests gegen den Galera-Verbund. Kopieren nach
# apps/server-db/config/dbtest.env (die echte Datei bleibt aus Git heraus),
# dann: set -a; . apps/server-db/config/dbtest.env; set +a; go test ./apps/server-db/...
# Ohne diese Variablen überspringen sich die Tests.
NGC_DB_NODES=db-1.ngc.test:3306,db-2.ngc.test:3306,db-3.ngc.test:3306
NGC_DB_NAME=ngc
NGC_DB_USER=ngc
NGC_DB_PASSWORD=
NGC_DB_MIGRATE_USER=ngc_migrate
NGC_DB_MIGRATE_PASSWORD=
# Pfad zum Zertifikat der CA der Installation (PEM), von ngc-db.sh ausgegeben.
NGC_DB_CA=/etc/ngc/db-tls/ca.crt
# Nur auf DB 1 und nur mit root: der Test hält den lokalen Knoten kurz an.
# NGC_DB_FAILOVER=local
