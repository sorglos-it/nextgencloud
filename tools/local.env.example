# Paths that belong to one machine, never to the repository. Copy this file
# to tools/local.env and write in what is true here; tools/local.env is not in
# git. tools/check.sh sources it, apps/web/tests/playwright.config.js reads the
# same line.
#
# Where php is, when it is installed but not on the PATH:
NGC_PHP=/usr/bin/php
