# Paths that belong to one machine, never to the repository. Copy this file
# to tools/local.env and write in what is true here; tools/local.env is not in
# git. tools/check.sh sources it, apps/web/tests/playwright.config.js reads the
# same line.
#
# Where php is, when it is installed but not on the PATH. The line stays
# commented here, because no machine's path belongs to the repository: copy
# the file, take the "#" away and write your own path. Without the line php
# is looked up on the PATH.
#NGC_PHP=/path/to/php
